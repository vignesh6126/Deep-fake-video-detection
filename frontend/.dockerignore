# Ignore node modules and build cache
node_modules
build
npm-debug.log
yarn-debug.log*
yarn-error.log*

# Ignore git and local metadata
.git
.gitignore
.DS_Store

# Ignore editor / OS files
.vscode
.idea
*.swp
*.swo
Thumbs.db

# Ignore environment files
.env
.env.local
.env.development
.env.production
.env.test

# Ignore Docker-related files
Dockerfile
docker-compose.yml

# Ignore test files
coverage
__tests__/
*.test.js
*.spec.js
